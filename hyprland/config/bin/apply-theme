#!/usr/bin/env bash
# Reapply visual components without ending the desktop session.
set -euo pipefail
HYPR_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
THEME_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-hyprland"
mkdir -p "$THEME_STATE_DIR"
export PATH="${XDG_DATA_HOME:-$HOME/.local/share}/hypr-theme/bin:$HOME/.local/bin:$PATH"
# shellcheck source=/dev/null
source "$HYPR_CONFIG_DIR/lib/theme-env"
"$HYPR_CONFIG_DIR/bin/cursor-switch" prepare
"$HYPR_CONFIG_DIR/bin/install-launchers"
"$HYPR_CONFIG_DIR/bin/app-theme"
Hyprland --verify-config --config "$HYPR_CONFIG_DIR/hyprland.lua"
hyprctl reload config-only
dbus-update-activation-environment --systemd PATH GTK_THEME QT_QPA_PLATFORMTHEME QT_PLUGIN_PATH \
    || printf '无法更新 D-Bus 激活环境。\n' >&2
"$HYPR_CONFIG_DIR/bin/cursor-effects" || printf '鼠标动画未能加载。\n' >&2
"$HYPR_CONFIG_DIR/bin/cursor-switch" apply || printf '鼠标设置未能完全应用。\n' >&2
"$HYPR_CONFIG_DIR/bin/workspace-switch" --restart || printf '工作区总览重启失败。\n' >&2
"$HYPR_CONFIG_DIR/bin/desktop-start" --restart || printf '部分桌面组件重启失败。\n' >&2
"$HYPR_CONFIG_DIR/bin/wallpaper" || printf '壁纸应用失败。\n' >&2
"$HYPR_CONFIG_DIR/bin/theme-mode" restore || printf '场景恢复失败。\n' >&2
