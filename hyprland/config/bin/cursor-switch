#!/usr/bin/env python3
"""Apply and remember cursor appearance, motion, shake zoom and size."""
from __future__ import annotations

import argparse
import configparser
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True
CONFIG = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(CONFIG / 'lib'))
from cursor_config import (DEFAULTS, MODES, SIZES, STATE, STATE_FILE, available_themes,
                           catalog, cursor_environment, ensure_legacy_search_path, load_settings)


def write(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    handle, temporary = tempfile.mkstemp(prefix='.' + path.name, dir=path.parent)
    try:
        with os.fdopen(handle, 'w') as stream:
            stream.write(value)
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


def render(state):
    environment = cursor_environment(state)
    boolean = lambda value: 'true' if value else 'false'
    native = bool(environment['HYPRCURSOR_THEME'])
    output = '-- Generated by cursor-switch; use Super+Shift+C to change.\n'
    output += ''.join('hl.env(' + json.dumps(key) + ', ' + json.dumps(value) + ')\n'
                      for key, value in environment.items())
    output += 'hl.config({cursor={enable_hyprcursor=' + boolean(native) + ',sync_gsettings_theme=false}})\n'
    output += ('if hl.plugin.dynamic_cursors then\n'
               '  hl.config({plugin={dynamic_cursors={enabled=true,mode=' + json.dumps(state['mode'])
               + ',shake={enabled=' + boolean(state['shake'])
               + '},hyprcursor={enabled=' + boolean(native) + ',nearest=0,resolution=96}}}})\nend\n')
    return output


def toolkit(environment):
    config_home = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config'))
    for version in ('3', '4'):
        path = config_home / f'gtk-{version}.0/settings.ini'
        config = configparser.ConfigParser(interpolation=None)
        config.optionxform = str
        config.read(path)
        if not config.has_section('Settings'):
            config.add_section('Settings')
        config.set('Settings', 'gtk-cursor-theme-name', environment['XCURSOR_THEME'])
        config.set('Settings', 'gtk-cursor-theme-size', environment['XCURSOR_SIZE'])
        from io import StringIO
        output = StringIO()
        config.write(output, space_around_delimiters=False)
        write(path, output.getvalue())
    for key, value in (('cursor-theme', environment['XCURSOR_THEME']), ('cursor-size', environment['XCURSOR_SIZE'])):
        subprocess.run(['gsettings', 'set', 'org.gnome.desktop.interface', key, value], check=True, capture_output=True)
    result = subprocess.run(['dbus-update-activation-environment', '--systemd', *environment],
                            env=dict(os.environ, **environment), capture_output=True, text=True)
    if result.returncode:
        print('D-Bus 鼠标环境未能更新：' + result.stderr.strip(), file=sys.stderr)


def apply(state):
    if not os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'):
        print('已保存；登录 Hyprland 后生效。')
        return
    environment = cursor_environment(state)
    # Disabling the high-resolution plugin path for legacy themes prevents its
    # default Hyprcursor fallback from replacing the chosen Xcursor on shake.
    # The plugin caches its motion enum on config.reloaded; eval alone would
    # update the reported option without necessarily changing the animation.
    subprocess.run(['hyprctl', 'reload', 'config-only'], check=True, capture_output=True, text=True)
    errors = subprocess.run(['hyprctl', 'configerrors'], check=True, capture_output=True, text=True).stdout.strip()
    if errors:
        raise RuntimeError(errors)
    toolkit(environment)
    theme = environment['HYPRCURSOR_THEME'] or environment['XCURSOR_THEME']
    # CXCursorManager caches theme+size, including a previous default fallback.
    # Change the size once so installing the bridge also refreshes that cache.
    for size in (str(state['size'] + 1), environment['XCURSOR_SIZE']):
        subprocess.run(['hyprctl', 'setcursor', theme, size], check=True, capture_output=True, text=True)
    subprocess.run([str(CONFIG / 'bin/theme-mode'), 'restore'], check=True, capture_output=True, text=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', nargs='?', default='status',
                        choices=['status', 'list', 'theme', 'mode', 'shake', 'size', 'reset', 'apply', 'prepare', 'env'])
    parser.add_argument('value', nargs='?')
    args = parser.parse_args()
    if args.action == 'env':
        if args.value:
            parser.error('env 不接受参数')
        print('\n'.join(cursor_environment().values()))
        return 0
    if args.action == 'list':
        for key, entry in available_themes().items():
            print(key + '\t' + entry['name'] + '\t' + entry['description'])
        return 0
    STATE.mkdir(parents=True, exist_ok=True)
    with (STATE / 'cursor-switch.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = load_settings()
        if args.action == 'status':
            print(json.dumps(state, ensure_ascii=False, indent=2))
            return 0
        if args.action == 'theme':
            if args.value not in available_themes():
                parser.error('该鼠标主题未安装；运行 cursor-switch list 查看可用外观')
            state['theme'] = args.value
        elif args.action == 'mode':
            if args.value not in MODES:
                parser.error('运动效果：stretch|tilt|rotate|none')
            state['mode'] = args.value
        elif args.action == 'shake':
            if args.value not in ('on', 'off'):
                parser.error('摇动放大：on|off')
            state['shake'] = args.value == 'on'
        elif args.action == 'size':
            if args.value not in [str(size) for size in SIZES]:
                parser.error('尺寸：24|28|32|36')
            state['size'] = int(args.value)
        elif args.value:
            parser.error('当前命令不接受第二个参数')
        elif args.action == 'reset':
            state = dict(DEFAULTS)
        ensure_legacy_search_path()
        source = render(state)
        write(STATE_FILE, json.dumps(state, ensure_ascii=False, indent=2) + '\n')
        write(CONFIG / 'cursors/current.lua', source)
        if args.action != 'prepare':
            apply(state)
            print('鼠标已应用：' + catalog()[state['theme']]['name'] + ' / ' + state['mode']
                  + ' / ' + str(state['size']) + ' px / 摇动放大' + ('开启' if state['shake'] else '关闭'))
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print('鼠标设置未完全应用：' + str(error), file=sys.stderr)
        raise SystemExit(1)
