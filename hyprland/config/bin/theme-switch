#!/usr/bin/env python3
"""Switch the desktop palette and optionally choose a fresh palette at login."""
from __future__ import annotations

import argparse
import fcntl
import json
import os
from pathlib import Path
import random
import re
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True
CONFIG = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(CONFIG / 'lib'))
from theme_palette import STATE, STATE_FILE, palettes, recolor, settings, selection_text


def write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    mode = path.stat().st_mode & 0o777 if path.exists() else 0o600
    handle, temporary = tempfile.mkstemp(prefix='.' + path.name, dir=path.parent)
    try:
        with os.fdopen(handle, 'w') as stream:
            stream.write(text)
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


def lua(value):
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False)
    if isinstance(value, list):
        return '{' + ','.join(lua(v) for v in value) + '}'
    if isinstance(value, dict):
        return '{' + ','.join('[' + lua(k) + ']=' + lua(v) for k, v in value.items()) + '}'
    raise TypeError(type(value))


def render(name, palette):
    colors = palette['colors']
    gtk = Path(os.environ.get('XDG_DATA_HOME', str(Path.home() / '.local/share'))) / 'themes' / palette['gtk_theme']
    if not all((gtk / version / 'gtk.css').is_file() for version in ('gtk-3.0', 'gtk-4.0')):
        raise RuntimeError(f'GTK 主题资源缺失：{gtk}。请运行 tools/build-gtk-themes.py。')
    generated = {}
    expected = ('waybar.css','dock.css','swaync.css','wofi.css','wlogout.css','hyprlock.conf','cava.conf','bash-theme.sh')
    if any(not re.fullmatch(r'#[0-9a-fA-F]{6}', value) for value in colors.values()):
        raise RuntimeError('主题颜色必须使用六位十六进制格式。')
    for filename in expected:
        template = CONFIG / 'themes/templates' / filename
        generated[CONFIG / filename] = recolor(template.read_text(), palette)
        if filename == 'waybar.css':
            generated[CONFIG / filename] += '\n/* Keep selected workspace labels readable on each palette. */\n'
            generated[CONFIG / filename] += '.workspace-label.active { color: ' + selection_text(palette, 'blue', 'purple') + '; }\n'
            generated[CONFIG / filename] += '.workspace-label.urgent { color: ' + selection_text(palette, 'red') + '; }\n'
        if filename == 'hyprlock.conf':
            generated[CONFIG / filename] = generated[CONFIG / filename].replace('/orbit-', '/' + palette['wallpaper'] + '-')
    rgba = lambda role, alpha: 'rgba(' + colors[role][1:] + alpha + ')'
    generated[CONFIG / 'themes/current.lua'] = (
        '-- Generated by theme-switch; edit palettes.json instead.\n'
        'hl.env("GTK_THEME", ' + lua(palette['gtk_theme']) + ')\n'
        'hl.config({general={col={active_border={colors={'
        + ','.join(lua(rgba(role, 'ff')) for role in ('blue', 'purple', 'cyan'))
        + '},angle=35},inactive_border=' + lua(rgba('overlay', '99'))
        + '}},decoration={shadow={color=0x66' + colors['black'][1:] + '}}})\n'
    )
    ansi = [colors[role] for role in ('black', 'red', 'green', 'yellow', 'blue', 'purple', 'cyan', 'muted')]
    brights = [colors[role] for role in ('overlay', 'red', 'green', 'yellow', 'blue', 'purple', 'cyan', 'fg')]
    terminal = {
        'foreground': colors['fg'], 'background': colors['bg'],
        'cursor_bg': colors['blue'], 'cursor_border': colors['blue'], 'cursor_fg': colors['black'],
        'selection_bg': colors['overlay'], 'selection_fg': colors['fg'],
        'ansi': ansi, 'brights': brights,
        'tab_bar': {
            'background': colors['bg'],
            'active_tab': {'bg_color': colors['blue'], 'fg_color': selection_text(palette), 'intensity': 'Bold'},
            'inactive_tab': {'bg_color': colors['surface'], 'fg_color': colors['muted']},
            'inactive_tab_hover': {'bg_color': colors['overlay'], 'fg_color': colors['fg']},
            'new_tab': {'bg_color': colors['bg'], 'fg_color': colors['comment']},
            'new_tab_hover': {'bg_color': colors['surface'], 'fg_color': colors['cyan']},
        },
    }
    generated[CONFIG / 'themes/wezterm.lua'] = '-- Generated desktop palette: ' + name + '\nreturn ' + lua(terminal) + '\n'
    generated[CONFIG / 'themes/kitty.conf'] = 'background ' + colors['black'] + '\nforeground ' + colors['fg'] + '\n'
    # A selector in the main WezTerm config also watches this small state file.
    generated[CONFIG / 'themes/current.json'] = json.dumps({'name': name, 'colors': colors}, indent=2) + '\n'
    generated[STATE / 'wallpaper'] = palette['wallpaper'] + '\n'
    return generated


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', nargs='?', default='status')
    parser.add_argument('value', nargs='?')
    parser.add_argument('--startup', action='store_true')
    parser.add_argument('--prepare', action='store_true', help='render without restarting components')
    args = parser.parse_args()
    available = palettes()
    STATE.mkdir(parents=True, exist_ok=True)
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', str(STATE))) / 'hypr-theme'
    runtime.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (runtime / 'theme-switch.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = settings()
        current = state.get('name', 'tokyo-night')
        if not isinstance(current, str) or current not in available:
            current = 'tokyo-night'
        enabled = state.get('random_on_login', True) is True
        if args.action == 'status' and not args.startup:
            print('当前主题：' + available[current]['name'])
            print('每次登录随机：' + ('开启' if enabled else '关闭'))
            return 0
        if args.action == 'list':
            for key, palette in available.items():
                print(key + '\t' + palette['name'] + '\t' + palette['description'])
            return 0
        if args.action == 'auto':
            if args.value not in ('on', 'off'):
                parser.error('用法：theme-switch auto on|off')
            state.update(name=current, random_on_login=args.value == 'on')
            write(STATE_FILE, json.dumps(state, ensure_ascii=False, indent=2) + '\n')
            print('每次登录随机已' + ('开启' if args.value == 'on' else '关闭'))
            return 0
        if args.value:
            parser.error('当前命令不接受第二个参数')
        name = args.action
        if args.startup:
            session = os.environ.get('HYPRLAND_INSTANCE_SIGNATURE', '')
            name = 'random' if enabled and session and state.get('last_session') != session else current
            state['last_session'] = session
        if name == 'random':
            name = random.SystemRandom().choice([key for key in available if key != current])
        if name not in available:
            parser.error('未知主题；运行 theme-switch list 查看列表')
        generated = render(name, available[name])
        previous = {path: path.read_text() if path.exists() else None for path in [*generated, STATE_FILE]}
        # Render and validate every file before changing the selected palette.
        try:
            for path, content in generated.items():
                write(path, content)
            state.update(name=name, random_on_login=enabled)
            write(STATE_FILE, json.dumps(state, ensure_ascii=False, indent=2) + '\n')
            if args.startup or args.prepare:
                subprocess.run([str(CONFIG / 'bin/app-theme')], check=True)
                if args.startup:
                    subprocess.run(['hyprctl', 'reload', 'config-only'], check=True)
            else:
                subprocess.run([str(CONFIG / 'bin/apply-theme')], check=True)
        except (OSError, subprocess.SubprocessError):
            for path, content in previous.items():
                if content is None:
                    path.unlink(missing_ok=True)
                else:
                    write(path, content)
            subprocess.run([str(CONFIG / 'bin/apply-theme')], check=False)
            raise
        if not args.startup and not args.prepare:
            try:
                subprocess.run(['notify-send', '-a', '桌面主题', '主题已切换', available[name]['name']], check=False)
            except OSError:
                pass
        print('当前主题：' + available[name]['name'])
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        print('主题切换失败：' + str(error), file=sys.stderr)
        raise SystemExit(1)
