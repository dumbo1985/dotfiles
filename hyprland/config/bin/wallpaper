#!/usr/bin/env bash
# Native-resolution artwork with a short GPU-friendly transition on both outputs.
set -euo pipefail
HYPR_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
THEME_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-hyprland"
export PATH="${XDG_DATA_HOME:-$HOME/.local/share}/hypr-theme/bin:$PATH"
mkdir -p "$THEME_STATE_DIR"
runtime_dir="${XDG_RUNTIME_DIR:-$HOME/.cache}/hypr-theme"
mkdir -p "$runtime_dir"
chmod 700 "$runtime_dir"
exec 9>"$runtime_dir/wallpaper.lock"
flock -n 9 || exit 0
current=$(cat "$THEME_STATE_DIR/wallpaper" 2>/dev/null || printf orbit)
case "${1:-restore}" in
    next)
        case "$current" in orbit) current=violet;; violet) current=aurora;; aurora) current=dusk;; *) current=orbit;; esac ;;
    orbit|violet|aurora|dusk) current=$1 ;;
    restore) ;;
    *) printf '用法：wallpaper [next|orbit|violet|aurora|dusk]\n' >&2; exit 2 ;;
esac
[[ $current =~ ^(orbit|violet|aurora|dusk)$ ]] || current=orbit
monitor_rows=$(hyprctl monitors -j | python3 -c 'import json,sys; [print(m["name"], m["transform"], sep="\t") for m in json.load(sys.stdin)]')
[[ -n "$monitor_rows" ]] || { printf '没有找到可用显示器。\n' >&2; exit 1; }
if command -v swww >/dev/null && command -v swww-daemon >/dev/null; then
    if ! swww query >/dev/null 2>&1; then
        printf -v daemon_command 'exec %q >%q 2>&1' "$(command -v swww-daemon)" "$THEME_STATE_DIR/swww.log"
        hyprctl eval "hl.exec_cmd([==[$daemon_command]==])" >/dev/null || true
        for _ in {1..30}; do swww query >/dev/null 2>&1 && break; sleep 0.1; done
    fi
    if swww query >/dev/null 2>&1; then
        transitions=(grow wipe fade)
        transition=${transitions[RANDOM % 3]}
        image_pids=()
        while IFS=$'\t' read -r output transform; do
            case "$transform" in 1|3|5|7) orientation=portrait;; *) orientation=landscape;; esac
            swww img --outputs "$output" "$HYPR_CONFIG_DIR/wallpapers/$current-$orientation.png" \
                --transition-type "$transition" --transition-duration 1 --transition-fps 45 --transition-bezier .22,.8,.2,1 &
            image_pids+=("$!")
        done <<< "$monitor_rows"
        images_ok=true
        for pid in "${image_pids[@]}"; do wait "$pid" || images_ok=false; done
        if "$images_ok"; then
            pkill -u "$(id -u)" -x swaybg || true
            printf '%s\n' "$current" > "$THEME_STATE_DIR/wallpaper"
            exit 0
        fi
    fi
fi
# Keep a working desktop even when the optional transition daemon is unavailable.
arguments=(-o '*' -i "$HYPR_CONFIG_DIR/wallpapers/$current-landscape.png" -m fill)
while IFS=$'\t' read -r output transform; do
    case "$transform" in 1|3|5|7) orientation=portrait;; *) orientation=landscape;; esac
    arguments+=(-o "$output" -i "$HYPR_CONFIG_DIR/wallpapers/$current-$orientation.png" -m fill)
done <<< "$monitor_rows"
pkill -u "$(id -u)" -x swww-daemon || true
pkill -u "$(id -u)" -x swaybg || true
printf -v command '%q ' swaybg "${arguments[@]}"
command="exec $command"
hyprctl eval "hl.exec_cmd([==[$command]==])" >/dev/null
printf '%s\n' "$current" > "$THEME_STATE_DIR/wallpaper"
