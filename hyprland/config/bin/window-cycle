#!/usr/bin/env python3
"""Cycle application groups or windows using a short-lived, stable MRU ring."""
import sys
from pathlib import Path
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'lib'))
from window_memory import cycle_main
if __name__ == '__main__':
    cycle_main()
