#!/usr/bin/env python3
"""Search open windows by application, title or workspace using the desktop theme."""
from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys

sys.dont_write_bytecode = True
CONFIG = Path(__file__).resolve().parent.parent
DATA = Path(os.environ.get('XDG_DATA_HOME', str(Path.home() / '.local/share')))
os.environ['PATH'] = str(DATA / 'hypr-theme/bin') + ':' + os.environ.get('PATH', '/usr/bin:/bin')


def clean(value, length=100):
    return ' '.join(re.sub(r'[\x00-\x1f\x7f]', ' ', str(value or '')).split())[:length]


def windows():
    result = subprocess.run(['hyprctl', 'clients', '-j'], capture_output=True, text=True, timeout=2, check=True)
    clients = json.loads(result.stdout)
    clients = [client for client in clients if client.get('mapped', True) and not client.get('hidden', False)
               and re.fullmatch(r'0x[0-9a-fA-F]+', client.get('address', ''))]
    clients.sort(key=lambda client: (client.get('focusHistoryID', 9999) < 0,
                                     client.get('focusHistoryID', 9999)))
    choices = {}
    for index, client in enumerate(clients, 1):
        workspace = client.get('workspace', {})
        name = workspace.get('name') or workspace.get('id', '?')
        app = clean(client.get('class') or client.get('initialClass') or '应用', 35)
        title = clean(client.get('title') or client.get('initialTitle') or '无标题')
        choices[f'{index:02d}   {clean(name, 18)} · {app}  —  {title}'] = client['address']
    return choices


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--list', action='store_true', help='print window choices without opening the menu')
    args = parser.parse_args()
    try:
        choices = windows()
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f'Cannot read Hyprland windows: {error}', file=sys.stderr)
        return 1
    if args.list:
        print('\n'.join(choices))
        return 0
    if not choices:
        subprocess.run(['notify-send', '窗口切换', '当前没有可切换的窗口'], check=False)
        return 0
    session = hashlib.sha256(os.environ.get('HYPRLAND_INSTANCE_SIGNATURE', 'default').encode()).hexdigest()[:12]
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
    with open(runtime / f'hypr-window-switcher-{session}.lock', 'w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        try:
            result = subprocess.run(['wofi', '--show', 'dmenu', '--conf', str(CONFIG / 'wofi.conf'),
                                     '--style', str(CONFIG / 'wofi.css'), '--prompt', '切换窗口…',
                                     '--cache-file', '/dev/null', '--define', 'allow_markup=false',
                                     '--define', 'allow_images=false'],
                                    input='\n'.join(choices) + '\n', capture_output=True, text=True)
        except OSError as error:
            print(f'Cannot open window switcher: {error}', file=sys.stderr)
            return 1
        selected = result.stdout.rstrip('\n')
        if result.returncode != 0 or selected not in choices:
            return 0
        selector = json.dumps('address:' + choices[selected])
        expression = 'hl.dispatch(hl.dsp.focus({window=' + selector + '}))'
        return subprocess.run(['hyprctl', 'eval', expression], capture_output=True, text=True).returncode


if __name__ == '__main__':
    raise SystemExit(main())
