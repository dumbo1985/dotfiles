{
  "$schema": "https://raw.githubusercontent.com/ErikReider/SwayNotificationCenter/v0.9.0/src/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 64,
  "control-center-margin-bottom": 20,
  "control-center-margin-right": 20,
  "control-center-margin-left": 20,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-icon-size": 48,
  "notification-body-image-height": 160,
  "notification-body-image-width": 300,
  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "control-center-width": 470,
  "control-center-height": 850,
  "notification-window-width": 430,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 180,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "label#heading",
    "buttons-grid#connectivity",
    "volume",
    "buttons-grid#scenes",
    "buttons-grid#utilities",
    "dnd",
    "title",
    "notifications"
  ],
  "widget-config": {
    "label#heading": {
      "text": "控制中心",
      "max-lines": 1
    },
    "buttons-grid#connectivity": {
      "actions": [
        {
          "label": "󰤨  网络",
          "command": "$HOME/.config/hypr/bin/control-center net"
        },
        {
          "label": "󰂯  蓝牙",
          "command": "$HOME/.config/hypr/bin/control-center bt"
        },
        {
          "label": "󰃭  日历",
          "command": "$HOME/.config/hypr/bin/control-center calendar"
        }
      ]
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true,
      "empty-list-label": "暂无应用正在播放声音",
      "expand-button-label": "应用音量  ",
      "collapse-button-label": "收起  ",
      "icon-size": 24,
      "animation-type": "slide_down",
      "animation-duration": 180
    },
    "buttons-grid#scenes": {
      "actions": [
        {
          "label": "󰖙  日间",
          "command": "$HOME/.config/hypr/bin/control-center day"
        },
        {
          "label": "󰖔  夜间",
          "command": "$HOME/.config/hypr/bin/control-center night"
        },
        {
          "label": "󰧑  专注",
          "command": "$HOME/.config/hypr/bin/control-center focus"
        }
      ]
    },
    "buttons-grid#utilities": {
      "actions": [
        {
          "label": "󰹑  截图",
          "command": "$HOME/.config/hypr/bin/control-center screenshot"
        },
        {
          "label": "󰌾  锁屏",
          "command": "$HOME/.config/hypr/bin/control-center lock"
        },
        {
          "label": "󰐥  电源",
          "command": "$HOME/.config/hypr/bin/control-center power"
        }
      ]
    },
    "dnd": {
      "text": "勿扰模式"
    },
    "title": {
      "text": "通知历史",
      "clear-all-button": true,
      "button-text": "清空"
    }
  }
}
