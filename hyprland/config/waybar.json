[
  {
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-top": 10,
    "margin-bottom": 0,
    "margin-left": 18,
    "margin-right": 18,
    "spacing": 3,
    "modules-left": [
      "custom/launcher",
      "custom/workspace1",
      "custom/workspace2",
      "custom/workspace3",
      "custom/workspace4",
      "custom/workspace5",
      "custom/workspace6",
      "custom/workspace7",
      "custom/workspace8",
      "custom/workspace9",
      "custom/workspace10"
    ],
    "modules-center": [
      "mpris",
      "clock"
    ],
    "modules-right": [
      "custom/system",
      "network#ethernet",
      "network#wifi",
      "bluetooth",
      "pulseaudio",
      "custom/weather",
      "custom/notifications",
      "tray",
      "custom/control",
      "custom/power"
    ],
    "custom/launcher": {
      "format": "󰀻",
      "on-click": "\"${XDG_CONFIG_HOME:-$HOME/.config}/hypr/bin/control-center\"",
      "tooltip-format": "桌面控制中心 · 右键剪贴板",
      "on-click-right": "\"${XDG_CONFIG_HOME:-$HOME/.config}/hypr/bin/clipboard\""
    },
    "clock": {
      "locale": "zh_CN.UTF-8",
      "format": "{:%H:%M  ·  %m月%d日}",
      "tooltip-format": "<tt>{calendar}</tt>\n点击打开日历与系统面板",
      "on-click": "\"${XDG_CONFIG_HOME:-$HOME/.config}/hypr/bin/desktop-panel\"",
      "on-click-right": "\"${XDG_CONFIG_HOME:-$HOME/.config}/hypr/bin/control-center\""
    },
    "pulseaudio": {
      "format": "󰕾 {volume}%",
      "format-muted": "󰖁 静音",
      "on-click": "\"${XDG_CONFIG_HOME:-$HOME/.config}/hypr/bin/control-center\"",
      "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
      "tooltip-format": "{desc}\n滚轮调音量 · 中键静音 · 右键声音面板",
      "on-click-right": "pavucontrol",
      "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 2%+",
      "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
    },
    "tray": {
      "spacing": 10,
      "icon-size": 17
    },
    "custom/workspace1": {
      "exec": "\"${XDG_CONFIG_HOME:-$HOME/.config}/hypr/bin/workspace-labels\" 1",
      "interval": 2,
      "return-type": "json",
      "format": "{text}",
      "escape": true,
      "tooltip": true,
      "on-click": "\"${XDG_CONFIG_HOME:-$HOME/.config}/hypr/bin/workspace-switch\" 1",
      "exec-on-event": true
    },
    "custom/workspace2": {
      "exec": "\"${XDG_CONFIG_HOME:-$HOME/.config}/hypr/bin/workspace-labels\" 2",
      "interval": 2,
