[
  {"label": "lock", "action": "$HOME/.config/hypr/bin/power-menu --lock", "text": "󰌾  锁定", "keybind": "l"},
  {"label": "logout", "action": "$HOME/.config/hypr/bin/power-menu --logout", "text": "󰍃  注销", "keybind": "e"},
  {"label": "cancel", "action": "true", "text": "󰅖  返回", "keybind": "c"},
