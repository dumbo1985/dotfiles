#!/usr/bin/env bash
#
# daily-wallpaper —— 每天自动更换 GNOME 桌面壁纸
#
# 优先下载 Bing 每日壁纸（每天本来就是新图），失败时回退到 picsum.photos 随机图。
# 下载成功后同时设置 GNOME 的浅色与深色壁纸，并保留最近 N 张历史文件。
#
# 用法：
#   daily-wallpaper              # 正常更换
#   daily-wallpaper --keep 30    # 指定历史保留张数
#   daily-wallpaper --source picsum   # 强制使用 picsum 源（当天固定一张）
#   daily-wallpaper --random          # 真随机换一张（picsum 不带 seed，每次不同）
#   daily-wallpaper --dry-run         # 只下载不设置壁纸

set -uo pipefail

# ---------- 配置 ----------
WALLPAPER_DIR="${HOME}/.local/share/wallpapers"
STATE_DIR="${HOME}/.local/state"
LOG_FILE="${STATE_DIR}/daily-wallpaper.log"
KEEP="${KEEP:-1}"                 # 保留最近多少张（1 = 只留当前一张，旧的自动删）
SOURCE="${SOURCE:-auto}"           # auto | bing | picsum
DRY_RUN=0
RANDOM_MODE=0                    # 1 = picsum 不带 seed，每次真随机
WIDTH=1920
HEIGHT=1080

# ---------- 参数解析 ----------
while [[ $# -gt 0 ]]; do
	case "$1" in
		--keep)   KEEP="$2"; shift 2 ;;
		--source) SOURCE="$2"; shift 2 ;;
		--random) RANDOM_MODE=1; shift ;;
		--dry-run) DRY_RUN=1; shift ;;
		-h|--help)
			sed -n '3,15p' "$0" | sed 's/^# \{0,1\}//'
			exit 0 ;;
		*) echo "未知参数: $1" >&2; exit 2 ;;
	esac
done

# --random：真随机换一张，强制走 picsum（Bing 一天只有一张，没法随机）
[[ "$RANDOM_MODE" == "1" ]] && SOURCE="picsum"

# ---------- 工具函数 ----------
mkdir -p "$WALLPAPER_DIR" "$STATE_DIR"

log() {
	# 日志同时写到文件，方便排查（systemd 环境下无终端）
	local msg="[$(date '+%Y-%m-%d %H:%M:%S')] $*"
	echo "$msg"
	echo "$msg" >>"$LOG_FILE" 2>/dev/null || true
}

die() { log "错误: $*"; exit 1; }

# 需要 gsettings 才能真正改壁纸；下载模式下允许缺失
command -v curl >/dev/null 2>&1 || die "缺少 curl，请先安装：sudo apt install curl"

TODAY="$(date '+%Y%m%d')"
EXT="jpg"
OUT="${WALLPAPER_DIR}/wallpaper-${TODAY}.${EXT}"

# ---------- 下载：Bing 每日壁纸 ----------
fetch_bing() {
	log "尝试 Bing 每日壁纸 ..."
	local api="https://www.bing.com/HPImageArchive.aspx?format=js&idx=0&n=1&mkt=zh-CN"
	local json
	json="$(curl -fsSL -m 20 "$api" 2>/dev/null)" || { log "Bing API 请求失败"; return 1; }

	# 从 JSON 中提取图片相对路径（避免依赖 jq）
	local rel
	rel="$(printf '%s' "$json" | grep -o '"urlbase":"[^"]*"' | head -n1 | cut -d'"' -f4)"
	[[ -n "$rel" ]] || { log "Bing 返回内容缺少 urlbase"; return 1; }

	local img_url="https://www.bing.com${rel}_${WIDTH}x${HEIGHT}.jpg"
	log "图片地址: $img_url"

	curl -fsSL -m 60 -o "${OUT}.part" "$img_url" || { log "Bing 图片下载失败"; rm -f "${OUT}.part"; return 1; }

	# 校验确实拿到的是图片
	file --mime-type -b "${OUT}.part" | grep -q '^image/' || { log "Bing 下载内容不是图片"; rm -f "${OUT}.part"; return 1; }

	mv -f "${OUT}.part" "$OUT"

	# 记录版权信息，便于了解图片来源
	# 注意：必须显式 return 0，否则末尾的条件判断会让函数返回非零值
	local copyright
	copyright="$(printf '%s' "$json" | grep -o '"copyright":"[^"]*"' | head -n1 | cut -d'"' -f4)"
	if [[ -n "$copyright" ]]; then
		log "图片来源: $copyright"
	fi
	return 0
}

# ---------- 下载：picsum 随机图（回退源） ----------
fetch_picsum() {
	log "尝试 picsum 随机图片 ..."
	local url
	if [[ "$RANDOM_MODE" == "1" ]]; then
		# --random：不带 seed，picsum 每次返回不同的图，手动换一张用
		url="https://picsum.photos/${WIDTH}/${HEIGHT}"
	else
		# 默认：固定当天 seed，保证同一天重复执行（cron/autostart）得到同一张图，不重复下载
		url="https://picsum.photos/seed/${TODAY}/${WIDTH}/${HEIGHT}"
	fi
	log "图片地址: $url"

	curl -fsSL -m 60 -o "${OUT}.part" "$url" || { log "picsum 下载失败"; rm -f "${OUT}.part"; return 1; }
	file --mime-type -b "${OUT}.part" | grep -q '^image/' || { log "picsum 下载内容不是图片"; rm -f "${OUT}.part"; return 1; }
	mv -f "${OUT}.part" "$OUT"
	return 0
}

# ---------- 设置壁纸 ----------
# systemd/cron 环境下拿不到会话 D-Bus，这里兜底补齐，避免 gsettings 静默失败。
ensure_session_bus() {
	local uid sock
	uid="$(id -u)"
	sock="/run/user/${uid}/bus"
	[[ -S "$sock" ]] || return 0
	if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
		export DBUS_SESSION_BUS_ADDRESS="unix:path=${sock}"
		export XDG_RUNTIME_DIR="/run/user/${uid}"
	elif [[ "$DBUS_SESSION_BUS_ADDRESS" == unix:path=* \
		&& ! -S "${DBUS_SESSION_BUS_ADDRESS#unix:path=}" ]]; then
		# 地址写错了（含未展开的 %U）时纠正
		export DBUS_SESSION_BUS_ADDRESS="unix:path=${sock}"
		export XDG_RUNTIME_DIR="/run/user/${uid}"
	fi
}

apply_wallpaper() {
	ensure_session_bus
	local uri="file://${OUT}"
	if ! command -v gsettings >/dev/null 2>&1; then
		log "未找到 gsettings，跳过设置（图片已保存到 $OUT）"
		return 0
	fi

	# 必须在图形会话的 D-Bus 上执行
	# 注意：gsettings 在连不上 dconf 后端时会「静默失败」（退出码仍为 0），
	# 因此下面每个设置都必须读回校验，不能只看退出码。
	local key val
	for key in picture-uri picture-uri-dark; do
		gsettings set "org.gnome.desktop.background" "$key" "$uri" 2>/dev/null
		val="$(gsettings get "org.gnome.desktop.background" "$key" 2>/dev/null)"
		if [[ "$val" != *"${OUT}"* ]]; then
			log "设置 $key 未生效（当前值: ${val:-<空>}）"
			log "提示：若在 systemd/cron 中运行，需注入 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/\$(id -u)/bus"
			return 1
		fi
	done

	gsettings set org.gnome.desktop.background picture-options 'zoom' 2>/dev/null || true

	log "壁纸已更新并校验通过: $OUT"
	return 0
}

# ---------- 清理旧文件 ----------
cleanup_old() {
	# 按修改时间保留最新 KEEP 张，其余删除（只动本目录下的 wallpaper-* 文件）
	[[ "$KEEP" =~ ^[0-9]+$ ]] || return 0
	local files
	files="$(find "$WALLPAPER_DIR" -maxdepth 1 -type f -name 'wallpaper-*' -printf '%T@ %p\n' 2>/dev/null \
		| sort -rn | awk -v k="$KEEP" 'NR>k {sub(/^[^ ]+ /, ""); print}')"
	[[ -z "$files" ]] && return 0

	local n=0
	while IFS= read -r f; do
		[[ -f "$f" ]] || continue
		# 不删除当前正在使用的那张
		[[ "$f" == "$OUT" ]] && continue
		rm -f -- "$f" && n=$((n + 1))
	done <<<"$files"
	(( n > 0 )) && log "已清理 $n 张旧壁纸（保留最近 $KEEP 张）"
	return 0
}

# ---------- 主流程 ----------
main() {
	log "===== 开始更新壁纸 (source=$SOURCE) ====="

	local ok=0
	case "$SOURCE" in
		bing)
			fetch_bing && ok=1
			;;
		picsum)
			fetch_picsum && ok=1
			;;
		auto)
			if fetch_bing; then
				ok=1
			else
				log "Bing 失败，回退到 picsum"
				fetch_picsum && ok=1
			fi
			;;
		*) die "未知 source: $SOURCE" ;;
	esac
	(( ok )) || die "所有图片源均下载失败"

	[[ -s "$OUT" ]] || die "下载的图片为空: $OUT"

	if (( DRY_RUN )); then
		log "dry-run 模式，跳过设置壁纸"
	else
		apply_wallpaper || die "设置壁纸失败"
	fi

	cleanup_old
	log "===== 完成 ====="
}

main
